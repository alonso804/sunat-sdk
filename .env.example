# Solo para scripts de prueba/integración. La librería NO lee variables de entorno por sí sola.
# Copia este archivo a `.env` (ya está en .gitignore) y completa los valores. Nunca lo subas a git.

# Los scripts scripts/beta-*.ts NO usan este archivo: traen fijos el RUC de pruebas, el usuario "MODDATOS" y la clave
# "MODDATOS". Los scripts *-prod-*.ts sí lo usan y apuntan siempre a PRODUCCIÓN (el ambiente no se elige aquí).

# --- Producción: datos del contribuyente (los mismos de la Ficha RUC) ---
# Reemplaza por TU RUC real (el valor de abajo es solo el RUC de pruebas de la beta).
SUNAT_RUC=20000000001
SUNAT_LEGAL_NAME=
# Ubigeo INEI de 6 dígitos del domicilio (catálogo 13 de SUNAT). Ej.: Chiguata, Arequipa = 040106
SUNAT_UBIGEO=
SUNAT_DEPARTMENT=
SUNAT_PROVINCE=
SUNAT_DISTRICT=
SUNAT_ADDRESS=
# Opcional: nombre comercial que sale arriba en la factura (p. ej. "MI EMPRESA E.I.R.L.")
SUNAT_TRADE_NAME=

# --- Producción: credenciales ---
# Usuario SOL (de preferencia un usuario secundario) y su clave
SUNAT_SOL_USER=MODDATOS
SUNAT_SOL_PASSWORD=MODDATOS
# SOL > Credenciales de API SUNAT (Id y Clave de la aplicación registrada)
GRE_CLIENT_ID=
GRE_CLIENT_SECRET=
# Certificado Digital Tributario (.p12/.pfx) y la contraseña que definiste al descargarlo.
# Guarda el archivo en `certs/` (está en .gitignore) o fuera del repositorio.
SUNAT_CERT_PATH=./certs/certificado.p12
SUNAT_CERT_PASSWORD=

# --- scripts/gre-prod-check.ts (guía de prueba) ---
# Serie de prueba (T + 3 caracteres). El portal SOL usa series EG##, así que no chocan; se usa una serie
# aparte para no consumir la T001 real con la guía de prueba.
GRE_TEST_SERIES=TZ01
GRE_TEST_NUMBER=1

# Confirmación del envío sin terminal interactiva (p. ej. con el prefijo `!` de Claude Code). Normalmente NO se guarda
# aquí: se pasa al ejecutar, con el nombre exacto que el script imprime. Ej.:
#   GRE_CONFIRM="ENVIAR 20000000001-09-TZ01-1" pnpm tsx --env-file=.env scripts/gre-prod-check.ts positive
# GRE_CONFIRM=

# --- Facturas en producción (scripts/invoice-prod-send.ts) ---
# Algoritmo de firma: sha1 (por defecto, lo que documenta el manual) o sha256. Cámbialo solo si SUNAT rechaza la firma.
# SUNAT_SIGNATURE_ALGORITHM=sha1
# Confirmación del envío sin terminal interactiva; mismo criterio: pásala al ejecutar, no la dejes guardada.
#   INVOICE_CONFIRM="ENVIAR <nombre>" pnpm tsx --env-file=.env scripts/invoice-prod-send.ts out/factura.json send
# INVOICE_CONFIRM=
